Project PropertyLookup {
  database_type: 'PostgreSQL'
  Note: 'Combines O Drive (Verbal System) and J Drive (Files) into a property lookup'
}

Table verbal_system {
  job_number varchar [pk]
  estate_name varchar [not null]
  street_name varchar [not null]
  block varchar [not null]

  Note: 'Source: O Drive (Verbal System)'
}

Table files {
  job_number varchar [pk, ref: - verbal_system.job_number]
  report text
  building_description text
  occupation_permit varchar
  certificate_of_compliance varchar

  Note: 'Source: J Drive (Files)'
}

Table property_description {
  id int [pk, increment]
  estate_name varchar [not null]
  street_name varchar [not null]
  block varchar [not null]
  building_description text
  occupation_permit varchar
  certificate_of_compliance varchar
  last_updated_from varchar [ref: > files.job_number, note: 'Internal only, not returned to AutomateReport']

  indexes {
    (estate_name, street_name, block) [unique, name: 'uq_property_address']
  }

  Note: 'One row per property (Estate + Street + Block)'
}

Table automate_report {
  id int [pk, increment]
  estate_name varchar [not null]
  street_name varchar [not null]
  block varchar [not null]
  building_description text [note: 'Returned from property_description on match']
  occupation_permit varchar [note: 'Returned from property_description on match']
  certificate_of_compliance varchar [note: 'Returned from property_description on match']
  requested_at timestamp [default: `now()`]

  indexes {
    (estate_name, street_name, block) [name: 'idx_report_address']
  }

  Note: 'Requests data by matching Estate, Street, Block from property_description. Does not return last_updated_from'
}

Ref: automate_report.(estate_name, street_name, block) > property_description.(estate_name, street_name, block)